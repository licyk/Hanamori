<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <HanamoriRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</HanamoriRoot>
    <HanamoriToolsetVersion>@TOOLSET@</HanamoriToolsetVersion>
    <HanamoriSdkVersion>@SDK@</HanamoriSdkVersion>
    <VCToolsVersion Condition="'$(VCToolsVersion)' == ''">$(HanamoriToolsetVersion)</VCToolsVersion>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == '' or '$(WindowsTargetPlatformVersion)' == '10.0'">$(HanamoriSdkVersion)</WindowsTargetPlatformVersion>
    <!-- With registry lookup disabled, v@TARGETS_VERSION@ targets require these versioned roots
         and later copy them over the public installation properties. -->
    <VCInstallDir_@TARGETS_VERSION@>$(HanamoriRoot)VC\</VCInstallDir_@TARGETS_VERSION@>
    <VCToolsInstallDir_@TARGETS_VERSION@>$(VCInstallDir_@TARGETS_VERSION@)Tools\MSVC\$(HanamoriToolsetVersion)\</VCToolsInstallDir_@TARGETS_VERSION@>
    <VCInstallDir>$(VCInstallDir_@TARGETS_VERSION@)</VCInstallDir>
    <VCToolsInstallDir>$(VCToolsInstallDir_@TARGETS_VERSION@)</VCToolsInstallDir>
    <WindowsSdkDir_10>$(HanamoriRoot)Windows Kits\10\</WindowsSdkDir_10>
    <WindowsSdkDir>$(WindowsSdkDir_10)</WindowsSdkDir>
    <UniversalCRTSdkDir_10>$(WindowsSdkDir_10)</UniversalCRTSdkDir_10>
    <UniversalCRTSdkDir>$(WindowsSdkDir_10)</UniversalCRTSdkDir>
    <UCRTVersion>$(HanamoriSdkVersion)</UCRTVersion>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <DisableRegistryUse>true</DisableRegistryUse>
    <UseEnv>true</UseEnv>
  </PropertyGroup>
</Project>
